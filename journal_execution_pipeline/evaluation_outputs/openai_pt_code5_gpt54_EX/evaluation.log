SELECT el.idcase, COUNT(*) AS total_eventos_ate_atividade FROM event_log el WHERE el.idcase IN ( SELECT idcase FROM event_log WHERE activity = 'Declaração final aprovada pelo diretor' ) AND el.timestamp <= ( SELECT MIN(el2.timestamp) FROM event_log el2 WHERE el2.idcase = el.idcase AND el2.activity = 'Declaração final aprovada pelo diretor' ) GROUP BY el.idcase;
SELECT el.idcase, COUNT(prev.id) AS eventos_anteriores FROM event_log el LEFT JOIN event_log prev ON prev.idcase = el.idcase AND prev.timestamp < el.timestamp WHERE el.activity = 'Declaração final aprovada pelo diretor' GROUP BY el.idcase, el.timestamp;
SELECT idcase, COUNT(*) AS intervencoes_ate_aprovacao_final_diretor FROM event_log e1 WHERE EXISTS ( SELECT 1 FROM event_log e2 WHERE e2.idcase = e1.idcase AND e2.activity = 'Declaração final aprovada pelo diretor' ) AND e1.timestamp <= ( SELECT MAX(e3.timestamp) FROM event_log e3 WHERE e3.idcase = e1.idcase AND e3.activity = 'Declaração final aprovada pelo diretor' ) GROUP BY idcase;
SELECT e1.idcase, CAST((julianday(e2.timestamp) - julianday(e1.timestamp)) * 24 * 60 * 60 AS INTEGER) AS tempo_segundos FROM event_log e1 JOIN event_log e2 ON e1.idcase = e2.idcase WHERE e1.activity = 'permissão requisitada pelo funcionário' AND e2.activity = 'permissão aprovada pela administração' AND e2.timestamp > e1.timestamp;
SELECT r.idcase, ROUND((julianday(a.aprovada_ts) - julianday(r.requisitada_ts)) * 24 * 60 * 60) AS intervalo_segundos FROM (SELECT idcase, MIN(timestamp) AS requisitada_ts FROM event_log WHERE activity = 'permissão requisitada pelo funcionário' GROUP BY idcase) r JOIN (SELECT idcase, MIN(timestamp) AS aprovada_ts FROM event_log WHERE activity = 'permissão aprovada pela administração' GROUP BY idcase) a ON r.idcase = a.idcase WHERE a.aprovada_ts >= r.requisitada_ts;
SELECT req.idcase, CAST((julianday(app.timestamp) - julianday(req.timestamp)) * 24 * 60 * 60 AS INTEGER) AS tempo_segundos FROM event_log AS req JOIN event_log AS app ON req.idcase = app.idcase WHERE req.activity = 'funcionário requisitar permissão' AND app.activity = 'permissão aprovada pela administração' AND req.timestamp < app.timestamp;
