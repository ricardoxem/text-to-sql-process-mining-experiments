SELECT e.idcase, COUNT(*) AS total_eventos_ate_fim_da_viagem FROM event_log e WHERE EXISTS ( SELECT 1 FROM event_log f WHERE f.idcase = e.idcase AND f.activity = 'Fim da viagem' AND e.timestamp <= f.timestamp ) GROUP BY e.idcase;
SELECT idcase, COUNT(*) AS total_ocorrencias_ate_fim_da_viagem FROM event_log WHERE timestamp <= ( SELECT MAX(e2.timestamp) FROM event_log e2 WHERE e2.idcase = event_log.idcase AND e2.activity = 'Fim da viagem' ) GROUP BY idcase HAVING EXISTS ( SELECT 1 FROM event_log e3 WHERE e3.idcase = event_log.idcase AND e3.activity = 'Fim da viagem' );
SELECT e.idcase, COUNT(*) AS ocorrencias_ate_fim_da_viagem FROM event_log e JOIN ( SELECT idcase, MIN(timestamp) AS fim_timestamp FROM event_log WHERE activity = 'Fim da viagem' GROUP BY idcase ) f ON e.idcase = f.idcase WHERE e.timestamp <= f.fim_timestamp GROUP BY e.idcase;
