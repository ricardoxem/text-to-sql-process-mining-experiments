SELECT resource, COUNT(*) AS casos FROM ( SELECT idcase, resource, ROW_NUMBER() OVER (PARTITION BY idcase ORDER BY timestamp, id) AS rn FROM event_log WHERE activity = 'declaração rejeitada pelo pré-aprovador' ) WHERE rn = 1 GROUP BY resource ORDER BY casos DESC, resource;
