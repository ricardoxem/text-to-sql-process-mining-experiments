WITH inicio AS ( SELECT idcase, MIN(timestamp) AS inicio FROM event_log GROUP BY idcase ), finais AS ( SELECT e.idcase, e.activity, e.timestamp FROM event_log e WHERE e.activity IN ('Fim da viagem', 'Declaração rejeitada pelo funcionário', 'Pagamento efetuado') ), ultimo_final AS ( SELECT f.idcase, f.activity, f.timestamp FROM finais f JOIN ( SELECT idcase, MAX(timestamp) AS timestamp FROM finais GROUP BY idcase ) m ON f.idcase = m.idcase AND f.timestamp = m.timestamp ) SELECT u.idcase, u.activity AS atividade_final, strftime('%s', u.timestamp) - strftime('%s', i.inicio) AS tempo_decorrido FROM ultimo_final u JOIN inicio i ON u.idcase = i.idcase;
WITH first_event AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), target_events AS ( SELECT idcase, activity, timestamp FROM event_log WHERE activity IN ('Fim da viagem', 'Declaração rejeitada pelo funcionário', 'Pagamento efetuado') ) SELECT t.idcase, t.activity AS atividade_final, strftime('%s', t.timestamp) - strftime('%s', f.start_time) AS tempo_segundos FROM target_events t JOIN first_event f ON f.idcase = t.idcase ORDER BY t.idcase, t.timestamp;
SELECT s.idcase, e.activity, strftime('%s', e.timestamp) - strftime('%s', s.start_time) AS tempo_decorrido FROM ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ) s JOIN event_log e ON e.idcase = s.idcase AND e.activity IN ('Fim da viagem', 'Declaração rejeitada pelo funcionário', 'Pagamento efetuado') ORDER BY s.idcase, e.timestamp;
WITH inicio AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), finais AS ( SELECT e.idcase, e.activity, e.timestamp FROM event_log e WHERE e.activity IN ('Fim da viagem', 'Declaração rejeitada pelo funcionário', 'Pagamento efetuado') ), primeiro_final AS ( SELECT f.idcase, f.activity, f.timestamp FROM finais f JOIN ( SELECT idcase, MIN(timestamp) AS end_time FROM finais GROUP BY idcase ) m ON f.idcase = m.idcase AND f.timestamp = m.end_time ) SELECT pf.idcase, pf.activity AS atividade_final, strftime('%s', pf.timestamp) - strftime('%s', i.start_time) AS tempo_segundos FROM primeiro_final pf JOIN inicio i ON pf.idcase = i.idcase;
WITH inicio AS ( SELECT idcase, MIN(timestamp) AS inicio_timestamp FROM event_log GROUP BY idcase ), finais AS ( SELECT idcase, activity, timestamp FROM event_log WHERE activity IN ('Fim da viagem', 'Declaração rejeitada pelo funcionário', 'Pagamento efetuado') ), ultimo_final AS ( SELECT f.idcase, f.activity, f.timestamp FROM finais f JOIN ( SELECT idcase, MAX(timestamp) AS fim_timestamp FROM finais GROUP BY idcase ) m ON f.idcase = m.idcase AND f.timestamp = m.fim_timestamp ) SELECT u.idcase, u.activity AS atividade_final, strftime('%s', u.timestamp) - strftime('%s', i.inicio_timestamp) AS tempo_decorrido FROM ultimo_final u JOIN inicio i ON u.idcase = i.idcase ORDER BY u.idcase;
WITH inicio AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), finais AS ( SELECT idcase, activity, MIN(timestamp) AS end_time FROM event_log WHERE activity IN ('Fim da viagem', 'Declaração rejeitada pelo funcionário', 'Pagamento efetuado') GROUP BY idcase, activity ) SELECT f.idcase, f.activity AS atividade_final, strftime('%s', f.end_time) - strftime('%s', i.start_time) AS tempo_decorrido FROM finais f JOIN inicio i ON i.idcase = f.idcase ORDER BY f.idcase, f.activity;
WITH case_start AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), target_events AS ( SELECT idcase, activity, MIN(timestamp) AS event_time FROM event_log WHERE activity IN ('Fim da viagem', 'Declaração rejeitada pelo funcionário', 'Pagamento efetuado') GROUP BY idcase, activity ) SELECT t.idcase, t.activity, strftime('%s', t.event_time) - strftime('%s', s.start_time) AS tempo_decorrido FROM target_events t JOIN case_start s ON s.idcase = t.idcase ORDER BY t.idcase, t.activity;
WITH start_events AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), target_events AS ( SELECT idcase, activity, MIN(timestamp) AS target_time FROM event_log WHERE activity IN ('Fim da viagem', 'Declaração rejeitada pelo funcionário', 'Pagamento efetuado') GROUP BY idcase, activity ) SELECT t.idcase, t.activity, strftime('%s', t.target_time) - strftime('%s', s.start_time) AS tempo_decorrido FROM target_events t JOIN start_events s ON s.idcase = t.idcase;
WITH first_event AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), target_events AS ( SELECT idcase, activity, MIN(timestamp) AS event_time FROM event_log WHERE activity IN ('Fim da viagem', 'Declaração rejeitada pelo funcionário', 'Pagamento efetuado') GROUP BY idcase, activity ) SELECT t.idcase, t.activity, strftime('%s', t.event_time) - strftime('%s', f.start_time) AS tempo_calculado FROM target_events t JOIN first_event f ON f.idcase = t.idcase ORDER BY t.idcase, t.activity;
SELECT idcase, ROUND((julianday(MIN(CASE WHEN activity IN ('Fim da viagem','Rejeitar solicitação','Pagamento efetuado') THEN timestamp END)) - julianday(MIN(timestamp))) * 24 * 60, 2) AS tempo_minutos FROM event_log GROUP BY idcase HAVING MIN(CASE WHEN activity IN ('Fim da viagem','Rejeitar solicitação','Pagamento efetuado') THEN timestamp END) IS NOT NULL;
