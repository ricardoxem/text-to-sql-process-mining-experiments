SELECT idcase, COUNT(*) AS ocorrencias_ate_fim_da_viagem FROM event_log e WHERE e.timestamp <= ( SELECT MIN(e2.timestamp) FROM event_log e2 WHERE e2.idcase = e.idcase AND e2.activity = 'Fim da viagem' ) GROUP BY idcase;
SELECT e.idcase, COUNT(*) AS quantidade_ocorrencias FROM event_log e JOIN ( SELECT idcase, MIN(timestamp) AS fim_ts FROM event_log WHERE activity = 'Fim da viagem' GROUP BY idcase ) f ON e.idcase = f.idcase WHERE e.timestamp <= f.fim_ts GROUP BY e.idcase;
