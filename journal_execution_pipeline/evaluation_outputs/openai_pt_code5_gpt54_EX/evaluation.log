SELECT COUNT(DISTINCT idcase) AS quantidade_casos, 'funcionário' AS grupo FROM event_log WHERE activity LIKE '%funcionário%' UNION SELECT COUNT(DISTINCT idcase) AS quantidade_casos, 'supervisor' AS grupo FROM event_log WHERE activity LIKE '%supervisor%' UNION SELECT COUNT(DISTINCT idcase) AS quantidade_casos, 'administração' AS grupo FROM event_log WHERE activity LIKE '%administração%' UNION SELECT COUNT(DISTINCT idcase) AS quantidade_casos, 'pré-aprovador' AS grupo FROM event_log WHERE activity LIKE '%pré-aprovador%' UNION SELECT COUNT(DISTINCT idcase) AS quantidade_casos, 'responsável pelo orçamento' AS grupo FROM event_log WHERE activity LIKE '%responsável pelo orçamento%' UNION SELECT COUNT(DISTINCT idcase) AS quantidade_casos, 'diretor' AS grupo FROM event_log WHERE activity LIKE '%diretor%';
SELECT COUNT(DISTINCT idcase) AS quantidade_casos, grupo FROM ( SELECT idcase, 'funcionário' AS grupo FROM event_log WHERE activity LIKE '%funcionário%' UNION ALL SELECT idcase, 'supervisor' AS grupo FROM event_log WHERE activity LIKE '%supervisor%' UNION ALL SELECT idcase, 'administração' AS grupo FROM event_log WHERE activity LIKE '%administração%' UNION ALL SELECT idcase, 'pré-aprovador' AS grupo FROM event_log WHERE activity LIKE '%pré-aprovador%' UNION ALL SELECT idcase, 'responsável pelo orçamento' AS grupo FROM event_log WHERE activity LIKE '%responsável pelo orçamento%' UNION ALL SELECT idcase, 'diretor' AS grupo FROM event_log WHERE activity LIKE '%diretor%' ) t GROUP BY grupo ORDER BY quantidade_casos, grupo;
SELECT COUNT(DISTINCT idcase) AS quantidade_casos, grupo FROM ( SELECT idcase, 'funcionário' AS grupo FROM event_log WHERE activity LIKE '%funcionário%' UNION ALL SELECT idcase, 'supervisor' AS grupo FROM event_log WHERE activity LIKE '%supervisor%' UNION ALL SELECT idcase, 'administração' AS grupo FROM event_log WHERE activity LIKE '%administração%' UNION ALL SELECT idcase, 'pré-aprovador' AS grupo FROM event_log WHERE activity LIKE '%pré-aprovador%' UNION ALL SELECT idcase, 'responsável pelo orçamento' AS grupo FROM event_log WHERE activity LIKE '%responsável pelo orçamento%' UNION ALL SELECT idcase, 'diretor' AS grupo FROM event_log WHERE activity LIKE '%diretor%' ) t GROUP BY grupo;
SELECT grupo, COUNT(DISTINCT idcase) AS quantidade_casos FROM ( SELECT idcase, 'funcionário' AS grupo FROM event_log WHERE activity LIKE '%funcionário%' UNION ALL SELECT idcase, 'supervisor' AS grupo FROM event_log WHERE activity LIKE '%supervisor%' UNION ALL SELECT idcase, 'administração' AS grupo FROM event_log WHERE activity LIKE '%administração%' UNION ALL SELECT idcase, 'pré-aprovador' AS grupo FROM event_log WHERE activity LIKE '%pré-aprovador%' UNION ALL SELECT idcase, 'responsável pelo orçamento' AS grupo FROM event_log WHERE activity LIKE '%responsável pelo orçamento%' UNION ALL SELECT idcase, 'diretor' AS grupo FROM event_log WHERE activity LIKE '%diretor%' ) t GROUP BY grupo;
SELECT grupo, COUNT(DISTINCT idcase) AS quantidade_declaracoes FROM ( SELECT idcase, 'funcionário' AS grupo FROM event_log WHERE activity LIKE '%funcionário%' UNION ALL SELECT idcase, 'supervisor' AS grupo FROM event_log WHERE activity LIKE '%supervisor%' UNION ALL SELECT idcase, 'administração' AS grupo FROM event_log WHERE activity LIKE '%administração%' UNION ALL SELECT idcase, 'pré-aprovador' AS grupo FROM event_log WHERE activity LIKE '%pré-aprovador%' UNION ALL SELECT idcase, 'responsável pelo orçamento' AS grupo FROM event_log WHERE activity LIKE '%responsável pelo orçamento%' UNION ALL SELECT idcase, 'diretor' AS grupo FROM event_log WHERE activity LIKE '%diretor%' ) t GROUP BY grupo ORDER BY quantidade_declaracoes;
SELECT grupo, activity, qtd FROM (SELECT 'funcionário' AS grupo, activity, COUNT(*) AS qtd FROM event_log WHERE activity LIKE '%funcionário%' GROUP BY activity UNION ALL SELECT 'supervisor' AS grupo, activity, COUNT(*) AS qtd FROM event_log WHERE activity LIKE '%supervisor%' GROUP BY activity UNION ALL SELECT 'administração' AS grupo, activity, COUNT(*) AS qtd FROM event_log WHERE activity LIKE '%administração%' GROUP BY activity UNION ALL SELECT 'pré-aprovador' AS grupo, activity, COUNT(*) AS qtd FROM event_log WHERE activity LIKE '%pré-aprovador%' GROUP BY activity UNION ALL SELECT 'responsável pelo orçamento' AS grupo, activity, COUNT(*) AS qtd FROM event_log WHERE activity LIKE '%responsável pelo orçamento%' GROUP BY activity UNION ALL SELECT 'diretor' AS grupo, activity, COUNT(*) AS qtd FROM event_log WHERE activity LIKE '%diretor%' GROUP BY activity) ORDER BY grupo, qtd DESC, activity;
SELECT CASE WHEN activity LIKE '%funcionário%' THEN 'funcionário' WHEN activity LIKE '%supervisor%' THEN 'supervisor' WHEN activity LIKE '%administração%' THEN 'administração' WHEN activity LIKE '%pré-aprovador%' THEN 'pré-aprovador' WHEN activity LIKE '%responsável pelo orçamento%' THEN 'responsável pelo orçamento' WHEN activity LIKE '%diretor%' THEN 'diretor' END AS grupo, activity, COUNT(*) AS quantidade_execucoes FROM event_log WHERE activity LIKE '%funcionário%' OR activity LIKE '%supervisor%' OR activity LIKE '%administração%' OR activity LIKE '%pré-aprovador%' OR activity LIKE '%responsável pelo orçamento%' OR activity LIKE '%diretor%' GROUP BY grupo, activity ORDER BY quantidade_execucoes DESC;
SELECT grupo, COUNT(*) AS quantidade FROM ( SELECT CASE WHEN activity LIKE '%funcionário%' THEN 'funcionário' WHEN activity LIKE '%supervisor%' THEN 'supervisor' WHEN activity LIKE '%administração%' THEN 'administração' WHEN activity LIKE '%pré-aprovador%' THEN 'pré-aprovador' WHEN activity LIKE '%responsável pelo orçamento%' THEN 'responsável pelo orçamento' WHEN activity LIKE '%diretor%' THEN 'diretor' END AS grupo FROM event_log WHERE activity LIKE '%funcionário%' OR activity LIKE '%supervisor%' OR activity LIKE '%administração%' OR activity LIKE '%pré-aprovador%' OR activity LIKE '%responsável pelo orçamento%' OR activity LIKE '%diretor%' ) t WHERE grupo IS NOT NULL GROUP BY grupo ORDER BY quantidade DESC, grupo;
