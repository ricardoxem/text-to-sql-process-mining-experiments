SELECT s.idcase, ROUND((julianday(a.timestamp) - julianday(s.timestamp)) * 24 * 60 * 60, 2) AS seconds_passed FROM event_log s JOIN event_log a ON s.idcase = a.idcase WHERE s.activity = 'Permit submitted by employee' AND a.activity = 'Permit approved by administration' AND a.timestamp > s.timestamp ORDER BY s.idcase, s.timestamp, a.timestamp;
