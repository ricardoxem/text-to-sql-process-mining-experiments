WITH first_events AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), end_events AS ( SELECT e.idcase, e.activity, e.timestamp FROM event_log e WHERE e.activity IN ('End trip', 'Declaration rejected by employee', 'Payment handled') ), last_relevant AS ( SELECT ee.idcase, ee.activity, ee.timestamp FROM end_events ee JOIN ( SELECT idcase, MAX(timestamp) AS end_time FROM end_events GROUP BY idcase ) m ON ee.idcase = m.idcase AND ee.timestamp = m.end_time ) SELECT l.idcase, l.activity, strftime('%s', l.timestamp) - strftime('%s', f.start_time) AS elapsed_time FROM last_relevant l JOIN first_events f ON l.idcase = f.idcase;
WITH case_start AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), end_events AS ( SELECT e.idcase, e.activity, e.timestamp FROM event_log e WHERE e.activity IN ('End trip', 'Declaration rejected by employee', 'Payment handled') ), last_relevant AS ( SELECT ee.idcase, ee.activity, ee.timestamp FROM end_events ee JOIN ( SELECT idcase, MAX(timestamp) AS end_time FROM end_events GROUP BY idcase ) m ON ee.idcase = m.idcase AND ee.timestamp = m.end_time ) SELECT lr.idcase, lr.activity, strftime('%s', lr.timestamp) - strftime('%s', cs.start_time) AS duration FROM last_relevant lr JOIN case_start cs ON lr.idcase = cs.idcase ORDER BY lr.idcase;
WITH first_events AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), target_events AS ( SELECT e.idcase, e.activity, e.timestamp FROM event_log e WHERE e.activity IN ('End trip', 'Declaration rejected by employee', 'Payment handled') ) SELECT t.idcase, t.activity, strftime('%s', t.timestamp) - strftime('%s', f.start_time) AS elapsed_time FROM target_events t JOIN first_events f ON t.idcase = f.idcase ORDER BY t.idcase, t.timestamp;
WITH first_event AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), final_events AS ( SELECT idcase, activity, timestamp FROM event_log WHERE activity IN ('End trip', 'Declaration rejected by employee', 'Payment handled') ), earliest_final AS ( SELECT fe.idcase, fe.start_time, MIN(f.timestamp) AS end_time FROM first_event fe JOIN final_events f ON f.idcase = fe.idcase GROUP BY fe.idcase, fe.start_time ) SELECT ef.idcase, ef.start_time, ef.end_time, (strftime('%s', ef.end_time) - strftime('%s', ef.start_time)) AS duration_seconds, f.activity AS final_activity FROM earliest_final ef JOIN final_events f ON f.idcase = ef.idcase AND f.timestamp = ef.end_time ORDER BY ef.idcase;
WITH first_event AS ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ), target_events AS ( SELECT e.idcase, e.activity, e.timestamp, ROW_NUMBER() OVER ( PARTITION BY e.idcase ORDER BY e.timestamp DESC, e.id DESC ) AS rn FROM event_log e WHERE e.activity IN ('End trip', 'Declaration rejected by employee', 'Payment handled') ) SELECT t.idcase, t.activity, strftime('%s', t.timestamp) - strftime('%s', f.start_time) AS elapsed_time FROM target_events t JOIN first_event f ON f.idcase = t.idcase WHERE t.rn = 1;
