SELECT idcase FROM event_log WHERE activity = ( SELECT activity FROM event_log GROUP BY activity ORDER BY COUNT(*) DESC LIMIT 1 ) AND idcase IN ( SELECT idcase FROM event_log WHERE activity = ( SELECT activity FROM event_log GROUP BY activity ORDER BY COUNT(*) DESC LIMIT 1 ) GROUP BY idcase HAVING COUNT(*) > 1 );
SELECT idcase FROM event_log WHERE activity = ( SELECT activity FROM event_log GROUP BY activity HAVING COUNT(*) > 1 ) AND id IN ( SELECT MAX(id) FROM event_log AS T1 INNER JOIN event_log AS T2 ON T1.activity = T2.activity AND T1.id < T2.id WHERE T1.resource = T2.resource GROUP BY T1.resource HAVING COUNT(*) > 1 );
SELECT idcase FROM event_log WHERE activity IN ( SELECT activity FROM event_log GROUP BY activity HAVING COUNT(*) > 1 );
SELECT id, activity FROM event_log WHERE activity = ( SELECT activity FROM event_log GROUP BY activity ORDER BY COUNT(activity) DESC LIMIT 1 );
SELECT * FROM event_log WHERE id = idcase AND activity = 'intervenção' GROUP BY idcase HAVING COUNT(id) > 1;
SELECT id FROM event_log WHERE id IN ( SELECT id FROM event_log GROUP BY id HAVING COUNT(*) > 1 );
SELECT * FROM employee WHERE supervisor_id IS NOT NULL;
SELECT * FROM event_log WHERE activity = 'assume_supervisor' AND resource IN (SELECT id FROM employee);
SELECT * FROM event_log WHERE activity = 'budget';
SELECT DISTINCT id FROM event_log WHERE activity = 'Assumiu Responsabilidade Orçamentária';
