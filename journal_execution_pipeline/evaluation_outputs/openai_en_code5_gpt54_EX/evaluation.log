SELECT s.idcase, strftime('%s', e.timestamp) - strftime('%s', s.start_time) AS duration, e.activity FROM ( SELECT idcase, MIN(timestamp) AS start_time FROM event_log GROUP BY idcase ) s JOIN ( SELECT el.idcase, el.activity, el.timestamp FROM event_log el JOIN ( SELECT idcase, MAX(timestamp) AS end_time FROM event_log WHERE activity IN ('End trip', 'Declaration rejected by employee', 'Payment handled') GROUP BY idcase ) m ON el.idcase = m.idcase AND el.timestamp = m.end_time WHERE el.activity IN ('End trip', 'Declaration rejected by employee', 'Payment handled') ) e ON s.idcase = e.idcase ORDER BY s.idcase;
WITH CaseBounds AS (SELECT idcase, MIN(timestamp) AS start_time, MAX(timestamp) AS end_time FROM event_log GROUP BY idcase) SELECT idcase, (strftime('%s', end_time) - strftime('%s', start_time)) AS case_duration FROM CaseBounds;
