SELECT e1.idcase, COUNT(e2.id) AS interventions_before_final_director_approval FROM event_log e1 JOIN event_log e2 ON e1.idcase = e2.idcase AND e2.timestamp <= e1.timestamp WHERE e1.activity = 'Declaration final approved by director' GROUP BY e1.idcase, e1.timestamp;
SELECT s.idcase, ROUND((julianday(a.timestamp) - julianday(s.timestamp)) * 24 * 60 * 60, 2) AS seconds_passed FROM event_log s JOIN event_log a ON s.idcase = a.idcase WHERE s.activity = 'Permit submitted by employee' AND a.activity = 'Permit approved by administration' AND a.timestamp > s.timestamp ORDER BY s.idcase, s.timestamp, a.timestamp;
SELECT s.idcase, s.timestamp AS submitted_timestamp, a.timestamp AS approved_timestamp, CAST((julianday(a.timestamp) - julianday(s.timestamp)) * 24 * 60 * 60 AS INTEGER) AS interval_seconds FROM event_log s JOIN event_log a ON s.idcase = a.idcase WHERE s.activity = 'Permit submitted by employee' AND a.activity = 'Permit approved by administration' AND a.timestamp >= s.timestamp ORDER BY s.idcase, s.timestamp, a.timestamp;
SELECT req.idcase, strftime('%s', appr.timestamp) - strftime('%s', req.timestamp) AS time_passed FROM event_log AS req JOIN event_log AS appr ON appr.idcase = req.idcase AND appr.activity = 'Permit approved by administration' WHERE req.activity = 'Permit requested by employee' AND appr.timestamp > req.timestamp AND appr.timestamp = ( SELECT MIN(a.timestamp) FROM event_log AS a WHERE a.idcase = req.idcase AND a.activity = 'Permit approved by administration' AND a.timestamp > req.timestamp );
SELECT DISTINCT idcase FROM (SELECT idcase, activity, LEAD(activity) OVER (PARTITION BY idcase ORDER BY timestamp) AS next_activity FROM event_log) WHERE activity = next_activity;
SELECT DISTINCT idcase FROM (SELECT idcase, activity, LEAD(activity) OVER (PARTITION BY idcase ORDER BY timestamp) AS next_activity FROM event_log) WHERE activity = next_activity;
SELECT DISTINCT idcase FROM (SELECT idcase, activity, LEAD(activity) OVER (PARTITION BY idcase ORDER BY timestamp) AS next_activity FROM event_log) WHERE activity = next_activity;
SELECT DISTINCT idcase FROM (SELECT idcase, activity, LEAD(activity) OVER (PARTITION BY idcase ORDER BY timestamp) AS next_activity FROM event_log) WHERE activity = next_activity;
SELECT DISTINCT idcase FROM (SELECT idcase, activity, LAG(activity) OVER (PARTITION BY idcase ORDER BY timestamp) AS prev_activity FROM event_log) WHERE activity = prev_activity;
SELECT idcase FROM event_log GROUP BY idcase, activity HAVING COUNT(*) > 1;
SELECT DISTINCT e1.idcase FROM event_log e1 JOIN event_log e2 ON e1.idcase = e2.idcase AND e2.timestamp = ( SELECT MIN(e3.timestamp) FROM event_log e3 WHERE e3.idcase = e1.idcase AND e3.timestamp > e1.timestamp ) WHERE e1.activity = e2.activity;
SELECT DISTINCT e1.idcase FROM event_log e1 JOIN event_log e2 ON e1.idcase = e2.idcase AND e2.timestamp = (SELECT MIN(e3.timestamp) FROM event_log e3 WHERE e3.idcase = e1.idcase AND e3.timestamp > e1.timestamp) WHERE e1.activity = e2.activity;
SELECT idcase, activity, COUNT(*) AS repetitions FROM event_log GROUP BY idcase, activity HAVING COUNT(*) > 1 ORDER BY idcase, activity;
