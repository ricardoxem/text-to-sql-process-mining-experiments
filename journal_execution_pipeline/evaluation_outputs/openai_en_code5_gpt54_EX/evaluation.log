SELECT activity, AVG(COALESCE(LEAD(strftime('%s', timestamp)) OVER (PARTITION BY idcase ORDER BY timestamp), strftime('%s', timestamp)) - strftime('%s', timestamp)) AS avg_duration_seconds FROM event_log GROUP BY activity;
SELECT activity, AVG(next_ts - curr_ts) AS mean_duration_seconds FROM ( SELECT activity, strftime('%s', timestamp) AS curr_ts, strftime('%s', LEAD(timestamp) OVER (PARTITION BY idcase ORDER BY timestamp)) AS next_ts FROM event_log ) WHERE next_ts IS NOT NULL GROUP BY activity;
SELECT activity, AVG(CAST((julianday(next_timestamp) - julianday(timestamp)) * 24 * 60 * 60 AS REAL)) AS avg_duration_seconds FROM ( SELECT activity, timestamp, LEAD(timestamp) OVER (PARTITION BY idcase ORDER BY timestamp) AS next_timestamp FROM event_log ) WHERE next_timestamp IS NOT NULL GROUP BY activity;
SELECT e1.activity, AVG((julianday(e2.timestamp) - julianday(e1.timestamp)) * 24 * 60 * 60) AS mean_duration FROM event_log e1 JOIN event_log e2 ON e1.idcase = e2.idcase AND e2.timestamp = ( SELECT MIN(e3.timestamp) FROM event_log e3 WHERE e3.idcase = e1.idcase AND e3.timestamp > e1.timestamp ) GROUP BY e1.activity;
SELECT activity, AVG(next_timestamp - timestamp) AS mean_duration FROM ( SELECT activity, timestamp, LEAD(timestamp) OVER (PARTITION BY idcase ORDER BY timestamp) AS next_timestamp FROM event_log ) WHERE next_timestamp IS NOT NULL GROUP BY activity;
SELECT activity, AVG(CAST((julianday(LEAD(timestamp) OVER (PARTITION BY idcase ORDER BY timestamp)) - julianday(timestamp)) * 24 * 60 * 60 AS REAL)) AS avg_duration_seconds FROM event_log GROUP BY activity;
SELECT e1.activity, AVG((julianday(e2.timestamp) - julianday(e1.timestamp)) * 24 * 60 * 60) AS average_duration FROM event_log e1 JOIN event_log e2 ON e1.idcase = e2.idcase AND e2.timestamp = ( SELECT MIN(e3.timestamp) FROM event_log e3 WHERE e3.idcase = e1.idcase AND e3.timestamp > e1.timestamp ) GROUP BY e1.activity;
SELECT activity, AVG(duration_seconds) FROM (SELECT e1.activity, MIN(strftime('%s', e2.timestamp)) - strftime('%s', e1.timestamp) AS duration_seconds FROM event_log e1 JOIN event_log e2 ON e1.idcase = e2.idcase AND e2.timestamp > e1.timestamp GROUP BY e1.id) GROUP BY activity;
