SELECT activity, AVG((julianday(LEAD(timestamp) OVER (PARTITION BY idcase ORDER BY timestamp)) - julianday(timestamp)) * 86400.0) AS mean_duration_time FROM event_log GROUP BY activity;
SELECT activity, AVG(CAST((julianday(timestamp) - julianday(prev_timestamp)) * 86400 AS REAL)) AS mean_duration_time FROM ( SELECT activity, timestamp, LAG(timestamp) OVER (PARTITION BY idcase ORDER BY timestamp) AS prev_timestamp FROM event_log ) WHERE prev_timestamp IS NOT NULL GROUP BY activity;
SELECT e1.activity, AVG((julianday(e2.timestamp) - julianday(e1.timestamp)) * 24 * 60 * 60) AS mean_duration_time FROM event_log e1 JOIN event_log e2 ON e1.idcase = e2.idcase AND e2.timestamp = ( SELECT MIN(e3.timestamp) FROM event_log e3 WHERE e3.idcase = e1.idcase AND e3.timestamp > e1.timestamp ) GROUP BY e1.activity;
